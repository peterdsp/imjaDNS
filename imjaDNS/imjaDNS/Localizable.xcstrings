      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργό, το iOS εφαρμόζει αυτόματα αυτό το DNS στα δεδομένα κινητής και το απενεργοποιεί στο Wi-Fi — επιβάλλεται από το σύστημα στο παρασκήνιο, ακόμη κι όταν το imjaDNS είναι κλειστό."
          }
        },
        "sq" : {
          "stringUnit" : {
